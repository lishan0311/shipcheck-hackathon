# Backend only. Never put the Supabase service role key in VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=shipping-documents
# Optional browser origin for a separately hosted Render frontend.
FRONTEND_ORIGIN=http://localhost:5173
# Local demo deliberately uses in-memory data, not SQLite. Data resets on restart.
# Set false on Render; missing Supabase settings then prevents startup.
ALLOW_DEMO_MODE=true
# Optional Windows path. Docker installs the native executable automatically.
TESSERACT_CMD=
OCR_LANGUAGE=eng
# Optional shared demo access token. Keep it in the backend env; enter it in the UI.
APP_ACCESS_TOKEN=
# Classify the bundled inbox in the background. Existing reports are skipped.
AUTO_PROCESS_INBOX=true
# Real Gmail / Google Workspace inbox. Enable the Gmail API and create an
# OAuth web client with http://127.0.0.1:8765/callback as a redirect URI.
MAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Use the authorized Gmail address so the UI shows which Inbox is connected.
GMAIL_USER_ID=me
MAIL_POLL_SECONDS=15
MAIL_SYNC_LIMIT=25
# Optional Gemini fallback. It runs only when the local classifier asks for
# human review, is capped per server process, and never blocks processing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_REQUESTS=20
GEMINI_MIN_CONFIDENCE=0.90
